# Copy to .env and adjust. The demo runs with all defaults (fully offline).

PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
TOKEN_SECRET=change-me-in-production

# Directory source: 'mock' (offline) or 'graph' (real Microsoft Graph)
DIRECTORY_PROVIDER=mock

# Email transport: 'console' logs instead of sending
EMAIL_TRANSPORT=console

# Only needed when DIRECTORY_PROVIDER=graph — the multi-tenant Entra app.
# Prefer certificate auth over a secret in production.
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Module assigned automatically when a user clicks/submits.
REMEDIATION_MODULE_ID=m-phish
