# Copy to .env on the droplet and fill in. NEVER commit the real .env.

# Public URL (must be the HTTPS domain Caddy serves). Consent + auth callbacks
# are derived from this, so it must match your Azure redirect URIs exactly.
PUBLIC_BASE_URL=https://breakphish.example.com
PORT=4000

# --- Secrets: generate with `openssl rand -hex 32` ---
SESSION_SECRET=REPLACE_WITH_RANDOM_32_BYTES
TOKEN_SECRET=REPLACE_WITH_RANDOM_32_BYTES

# --- Microsoft / Entra (from your Azure app registration) ---
# Switch these from 'mock' to 'graph'/'entra' once the Azure app is set up.
DIRECTORY_PROVIDER=mock
AUTH_PROVIDER=mock
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
PARTNER_TENANT_ID=
# Redirect URIs to register in Azure (informational — derived from PUBLIC_BASE_URL):
#   {PUBLIC_BASE_URL}/onboarding/consent/callback
#   {PUBLIC_BASE_URL}/auth/callback

# --- Phishing-simulation sending (your ESP + lookalike domains) ---
SENDING_DOMAINS=secure-notify.yourmsp.com
SENDING_IPS=
SIM_URL_HOST=track.yourmsp.com

# --- Settings page: read-only "update available?" check (optional) ---
# Set to your repo to enable the update indicator in Settings.
GITHUB_REPO=
GITHUB_BRANCH=main
# Only needed if the repo is PRIVATE (a fine-grained PAT with Contents:read):
GITHUB_TOKEN=

# --- Persistence (DigitalOcean Managed PostgreSQL) ---
# Paste the connection string from the DO panel (Databases → Connection details).
# When set, the app applies db/schema.sql on boot. Leave blank to run in-memory.
# DATABASE_URL=postgres://user:pass@your-do-db-host:25060/breakphish?sslmode=require
# DB_POOL_MAX=10
# REDIS_URL=rediss://default:pass@your-do-redis-host:25061   # later, for the shared queue
